<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <h2>Item dalam kategori ini:</h2>
    <ul>
        <% items.forEach((item) => { %>
            <li>
                <a href="/items/<%= item.id %>/edit"><%= item.name %></a>
                - Rp <%= item.price %>
                - Stok: <%= item.stock %>
                <form method="POST" action="/items/<%= item.id %>/delete" style="display:inline">
                    <button type="submit">Hapus</button>
                </form>
            </li>
        <% }) %>
    </ul>

    <a href="/items/new">Tambah Item Baru</a>
    <br>
    <a href="/categories">Kembali</a>
</body>
</html>